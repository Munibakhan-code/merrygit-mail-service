# Server Configuration
APP_NAME="OTP Mail Service"
APP_VERSION="1.0.0"
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO

# RabbitMQ Configuration
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_QUEUE_NAME=send-otp
RABBITMQ_PREFETCH_COUNT=10

# RabbitMQ Reconnection Settings
RABBITMQ_RECONNECT_ATTEMPTS=5
RABBITMQ_RECONNECT_DELAY=5
RABBITMQ_RECONNECT_MAX_DELAY=30

# Resend Email Configuration
RESEND_API_KEY=re_1234567890abcdefghijklmnopqrstuvwxyz
RESEND_FROM_EMAIL=info@merrygit.tech
RESEND_FROM_NAME="MerryGit"

# Email Settings
EMAIL_TIMEOUT=30